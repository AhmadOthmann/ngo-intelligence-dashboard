# Use deterministic analysis unless you explicitly enable OpenAI.
APP_ENV=development
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low

# Destructive demo helpers require this flag plus an explicit local/test APP_ENV.
# Keep false in every hosted environment.
ENABLE_DEMO_ENDPOINTS=true

# Optional comma-separated exact-host allowlist for RSS and web ingestion.
# Subdomains are not implicit. This setting is required when APP_ENV=production.
# SOURCE_DOMAIN_ALLOWLIST=reliefweb.int,www.devex.com,feeds.bbci.co.uk
SOURCE_DOMAIN_ALLOWLIST=

# Local SQLite file. Use a mounted persistent path in a hosted container.
DATABASE_PATH=items.db

# Optional comma-separated browser origins, for example:
# CORS_ORIGINS=https://dashboard.example.org
CORS_ORIGINS=
