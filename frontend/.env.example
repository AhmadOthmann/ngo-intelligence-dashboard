# Direct local browser-to-backend calls
VITE_API_BASE_URL=http://127.0.0.1:8000

# Development already shows the destructive local demo-data control.
# Do not enable it in a hosted production build.
VITE_ENABLE_DEMO_CONTROLS=false

# For a hosted same-origin /api proxy, use:
# VITE_API_BASE_URL=/api
# BACKEND_ORIGIN=https://api.example.org
