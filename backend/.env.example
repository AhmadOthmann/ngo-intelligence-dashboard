# Use deterministic analysis unless you explicitly enable OpenAI.
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_REASONING_EFFORT=low

# Local SQLite file. Use a mounted persistent path in a hosted container.
DATABASE_PATH=items.db

# Optional comma-separated browser origins, for example:
# CORS_ORIGINS=https://dashboard.example.org
CORS_ORIGINS=
